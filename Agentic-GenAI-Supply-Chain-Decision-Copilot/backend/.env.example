APP_NAME=SupplyChain AI
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# Database Configuration
POSTGRES_USER=supplychain_user
POSTGRES_PASSWORD=supplychain_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=supplychain_db
DATABASE_URL=postgresql://supplychain_user:supplychain_pass@localhost:5432/supplychain_db

# LLM Configuration (Configurable: ollama / openai / anthropic)
LLM_PROVIDER=ollama
LLM_MODEL=llama3:latest
LLM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
